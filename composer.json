{
    "name": "alain-l/fulltextsearch_postgresql",
    "description": "Nextcloud full-text search platform backed by PostgreSQL",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Alain Lesage",
            "role": "Author and maintainer"
        }
    ],
    "type": "project",
    "require": {
        "php": ">=8.1",
        "smalot/pdfparser": "2.12.5"
    },
    "replace": {
        "symfony/polyfill-mbstring": "*"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "OCA\\FullTextSearch_PostgreSQL\\": "lib/"
        }
    }
}
